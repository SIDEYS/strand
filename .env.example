# HTTP + WebSocket gateway
HOST=0.0.0.0
PORT=8080

# Unique per running process; defaults to a random UUID. Set it only when you
# want stable IDs in logs. Two live instances must never share one.
# INSTANCE_ID=

# Signs resume tokens. Required when REDIS_URL is set, and every instance must
# use the same value. Generate one with: openssl rand -base64 32
# Never commit a real value; set it in your deployment environment.
# RESUME_SECRET=
# How long a resume token is valid (it cannot be revoked once issued).
RESUME_TTL_MS=300000

# Cross-instance fan-out. Leave REDIS_URL unset to run one standalone instance.
REDIS_URL=redis://localhost:6379
# How often each instance announces its state so peers can repair anything
# pub/sub dropped. Upper bound on how long divergence persists once healthy.
RECONCILE_INTERVAL_MS=5000
# How long a newly-started room waits for peers before serving what it has.
JOIN_SYNC_TIMEOUT_MS=500
# Presence is refreshed on every heartbeat; this must be >= 2x the heartbeat.
PRESENCE_TTL_MS=45000

# Connection lifecycle tuning
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_MAX_MISSED_PONGS=2
BACKPRESSURE_THRESHOLD_BYTES=1048576
MAX_INBOUND_MESSAGE_BYTES=65536

# Logging
LOG_LEVEL=info

# Postgres (unused until Phase 5)
DATABASE_URL=postgres://strand:strand@localhost:5432/strand
