{
  "name": "strand",
  "version": "0.1.0",
  "private": true,
  "description": "Horizontally-scaled realtime collaborative Markdown editor",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migrations-table pgmigrations",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migrations-table pgmigrations"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "eslint": "^9.15.0",
    "testcontainers": "^12.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^5.0.1"
  }
}
