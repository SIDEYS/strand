{
  "name": "strand",
  "version": "0.1.0",
  "private": true,
  "description": "Horizontally-scaled realtime collaborative Markdown editor",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migrations-table pgmigrations",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migrations-table pgmigrations",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "marked": "^18.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.18.0",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.15.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
